<form class="{{cssClass}} flexcol" autocomplete="off">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Name" />
      </h1>
      <div class="header-details flexrow">
        <div class="field-group">
          <label>Rank</label>
          <input type="text" name="system.rank" value="{{system.rank}}" placeholder="e.g. Colonel" />
        </div>
        <div class="field-group">
          <label>Level</label>
          <input type="number" name="system.level" value="{{system.level}}" min="1" />
        </div>
        <div class="field-group">
          <label>Race</label>
          <input type="text" name="system.race.name" value="{{system.race.name}}" />
        </div>
        <div class="field-group">
          <label>Multiplier</label>
          <input type="number" name="system.race.multiplier" value="{{system.race.multiplier}}" step="0.1" min="0.1" />
        </div>
      </div>
      <div class="health-row flexrow">
        <label>HP</label>
        <input type="number" name="system.health.value" value="{{system.health.value}}" />
        <span>/</span>
        <input type="number" name="system.health.max" value="{{system.health.max}}" />
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="cards" data-group="primary">Cards</a>
    <a class="item" data-tab="bio" data-group="primary">Biography</a>
  </nav>

  <section class="sheet-body">

    <div class="tab" data-tab="cards" data-group="primary">

      <div class="card-slots-info">
        Slots: {{system.cardSlots.total}} &nbsp;|&nbsp; Total Power: {{system.totalCardValue}}
        {{#if system.race.multiplier}}
          <span class="multiplier">(×{{system.race.multiplier}})</span>
        {{/if}}
      </div>

      {{#each (array "abilities" "weapons" "objects") as |section|}}
      {{! We'll do each section manually below }}
      {{/each}}

      <div class="card-section">
        <div class="card-section-header">
          <h3>Abilities</h3>
          <a data-action="addCard" data-type="ability" title="Add Ability" style="cursor:pointer">+</a>
        </div>
        {{#each abilities as |card|}}
        <div class="card-entry {{#if card.system.locked}}locked{{/if}}" data-item-id="{{card.id}}">
          <span class="card-name">{{card.name}}</span>
          <span class="card-value">{{card.system.value}}{{#if card.system.locked}} 🔒{{/if}}</span>
          <div class="card-controls">
            {{#if @root.isGM}}<a data-action="toggleLock" title="Toggle Lock" style="cursor:pointer">🔒</a>{{/if}}
            <a data-action="editCard" title="Edit" style="cursor:pointer">✏️</a>
            <a data-action="deleteCard" title="Delete" style="cursor:pointer">🗑️</a>
          </div>
        </div>
        {{/each}}
      </div>

      <div class="card-section">
        <div class="card-section-header">
          <h3>Weapons</h3>
          <a data-action="addCard" data-type="weapon" title="Add Weapon" style="cursor:pointer">+</a>
        </div>
        {{#each weapons as |card|}}
        <div class="card-entry {{#if card.system.locked}}locked{{/if}}" data-item-id="{{card.id}}">
          <span class="card-name">{{card.name}}</span>
          <span class="card-value">{{card.system.value}}{{#if card.system.locked}} 🔒{{/if}}</span>
          <div class="card-controls">
            {{#if @root.isGM}}<a data-action="toggleLock" title="Toggle Lock" style="cursor:pointer">🔒</a>{{/if}}
            <a data-action="editCard" title="Edit" style="cursor:pointer">✏️</a>
            <a data-action="deleteCard" title="Delete" style="cursor:pointer">🗑️</a>
          </div>
        </div>
        {{/each}}
      </div>

      <div class="card-section">
        <div class="card-section-header">
          <h3>Objects</h3>
          <a data-action="addCard" data-type="object" title="Add Object" style="cursor:pointer">+</a>
        </div>
        {{#each objects as |card|}}
        <div class="card-entry {{#if card.system.locked}}locked{{/if}}" data-item-id="{{card.id}}">
          <span class="card-name">{{card.name}}</span>
          <span class="card-value">{{card.system.value}}{{#if card.system.locked}} 🔒{{/if}}</span>
          <div class="card-controls">
            {{#if @root.isGM}}<a data-action="toggleLock" title="Toggle Lock" style="cursor:pointer">🔒</a>{{/if}}
            <a data-action="editCard" title="Edit" style="cursor:pointer">✏️</a>
            <a data-action="deleteCard" title="Delete" style="cursor:pointer">🗑️</a>
          </div>
        </div>
        {{/each}}
      </div>

    </div>

    <div class="tab" data-tab="bio" data-group="primary">
      <textarea name="system.biography" placeholder="Character background...">{{system.biography}}</textarea>
    </div>

  </section>

  <footer class="sheet-footer">
    <button type="button" data-action="engageAction">⚔️ Engage Action</button>
  </footer>

</form>